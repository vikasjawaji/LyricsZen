{
  "manifest_version": 3,
  "name": "LyricsZen for YouTube Music™",
  "short_name": "LyricsZen",
  "version": "1.0.0",
  "description": "A distraction-free, full-screen, typography-focused lyrics and karaoke view for YouTube Music.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "LyricsZen for YouTube Music™"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "run_at": "document_idle",
      "js": [
        "src/youtube-music/navigation.js",
        "src/youtube-music/player.js",
        "src/lyrics/lyrics-provider.js",
        "src/lyrics/lyrics-engine.js",
        "src/lyrics/lyrics-sync.js",
        "src/ui/lyrics-overlay.js",
        "src/content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/ui/lyrics.css"],
      "matches": ["https://music.youtube.com/*"]
    }
  ],
  "commands": {
    "toggle-lyrics-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Toggle Lyrics Mode"
    }
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://lrclib.net/*",
    "https://api.lyrics.ovh/*"
  ]
}
